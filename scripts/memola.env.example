# ============================================================================
# Memola AI relay — 設定ファイル
# ============================================================================
#
# このファイルをコピーして `memola.env` として保存し、自分の環境に
# 合わせて値を編集してください。
#
#   PowerShell:   Copy-Item memola.env.example memola.env
#   コマンド:     copy memola.env.example memola.env
#
# `memola.env` は .gitignore で除外され、リポジトリにはコミット
# されません (秘密情報を安全に入れられます)。
#
# 形式: 1 行 1 設定、KEY=VALUE。コメントは `#` から行末まで。
# クォート (`"..."` / `'...'`) があれば自動で剥がします。
# ============================================================================

# 社内 AI ゲートウェイ / Azure OpenAI 互換エンドポイントの URL (パスまで含む)
# 例: Azure OpenAI リソースのベース
CORP_AI_TARGET=https://YOUR-RESOURCE.openai.azure.com

# オンプレ プロキシの URL (不要なら空 or 行ごと削除)
CORP_AI_PROXY=http://onprem-proxy.example.com:8080

# ローカル listen ポート (Memola 側「ベース URL」と同期させる)
CORP_AI_PORT=18080

# 任意: 自己署名証明書を許容 (検証用途のみ、本番禁止)。値を `1` で有効。
# CORP_AI_SKIP_CERT_CHECK=0

# ─── AI 設定 (env 集約・チーム共通) ───────────────────────────────────────
# 外部ベクトル と同じ考え方: モデル/デプロイ/埋め込み等の AI 設定はここ (env) に集約し、
# relay が `GET /memola/ai-config` で配信する。ブラウザは起動時にこれを取得して
# 自動で設定へ反映するので、各メンバーは「API キーだけ」をブラウザで入力すれば
# 残りは全員 env で統一される。
#
#  ★ API キー (corp / Voyage) はここには絶対に書かない。
#    キーは各自のブラウザ (Memola 設定 → AI) に入力する。env / git には残さない。
#
# このリレーは社内 AI ゲートウェイ (corp) 専用。env で配信するのは corp チャットと
# 埋め込み (RAG) の設定のみ。Claude(Anthropic 直叩き) / ローカル LLM はリレーを
# 経由しないため env では扱わず、使う場合はブラウザ (Memola 設定 → AI) で設定する。
#
# 設定しなかった項目はブラウザ側の既定値/個人設定がそのまま使われる。
# corpBaseUrl は未指定なら relay 自身 (http://localhost:<CORP_AI_PORT>) を自動で指す。

# チャットのプロバイダ (このリレー経由なので corp 固定)
# MEMOLA_AI_PROVIDER=corp

# 社内ゲートウェイ (corp) のモデル / デプロイ接頭辞
# MEMOLA_AI_CORP_MODEL=gpt-4o
# MEMOLA_AI_CORP_DEPLOY_PREFIX=
# corpBaseUrl を relay 以外に向けたい場合のみ明示 (通常は不要)
# MEMOLA_AI_CORP_BASEURL=

# ─── 埋め込み (RAG / 横断チャット) ───────────────────────────────────────
# 埋め込みプロバイダ: voyage | auto(=corp/Azure 互換の embeddings)
# MEMOLA_EMBED_PROVIDER=voyage
# Voyage のモデル
# MEMOLA_VOYAGE_MODEL=voyage-3.5-lite
# auto(Azure 互換) の埋め込みモデル / api-version / 次元 (空=サーバ既定)
# MEMOLA_EMBED_MODEL=text-embedding-3-small
# MEMOLA_EMBED_APIVERSION=2024-02-01
# MEMOLA_EMBED_DIMENSIONS=

# RAG 検索の上位件数 / 最小スコア
# MEMOLA_RAG_TOPK=8
# MEMOLA_RAG_MINSCORE=0.2

# ─── ワンクリック起動 (memola-start.bat) で使う設定 ───────────────────────
# memola-start.bat (中身は memola-start.ps1) が「リレー起動 + ブラウザで
# SharePoint を開く + 案内ダイアログ表示」を 1 アクションでやってくれる。
# (リレーだけ起動したい場合は corp-ai-relay.bat)
#
# このアプリ自体は SharePoint のどのサイトからでも起動できる (ブックマーク
# レット形式)。なので MEMOLA_SITE_URL は「あなたがいつも開く Memola の置き場」
# = チームで共有してる SP サイトの URL を 1 つ書いておけば OK。
#
# 運用パターン:
#   - チーム共通: env を git で共有していれば、全員が同じ SP サイトに飛ぶ
#   - 個人別: 各自の env に自分用 URL を書けば自分の場所が開く
#   - 未設定: 起動時にプロンプトで URL を聞かれる (1 回入力すれば次回から覚える
#            よう env に書き込んでおく)
#
# 取得方法: SharePoint でいつも Memola を起動してるサイトのトップ URL をコピー。
#   例: https://contoso.sharepoint.com/sites/team-memola
#       https://contoso.sharepoint.com/sites/foo/SitePages/Home.aspx
#       (サブパスでも OK。SharePoint ページなら何でも)
#
# MEMOLA_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
